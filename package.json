{
  "name": "@anymousxe/axon-cli",
  "version": "1.3.2",
  "description": "A fast, dependency-free terminal companion for the Axon model API.",
  "type": "module",
  "bin": {
    "axon": "bin/axon.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node bin/axon.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node tests/smoke.mjs",
    "smoke:live": "node tests/smoke.mjs --live",
    "check": "npm run build && npm test && npm run smoke",
    "prepack": "npm run build",
    "smoke:terminal": "node tests/live-terminal.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/build.mjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "docs/hero.svg",
    "examples/live-transcript.txt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anymousxe/axon-cli.git"
  },
  "homepage": "https://github.com/anymousxe/axon-cli#readme",
  "keywords": [
    "axon",
    "ai",
    "cli",
    "chat",
    "terminal",
    "vision"
  ],
  "publishConfig": {
    "access": "public"
  }
}
